<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Hardened Runtime baseline, required by notarization. Kinestasis
        reads user-selected stills/folders (drag-and-drop, NSOpenPanel)
        and writes ProRes/XML to user-selected destinations — both fine
        without extra entitlements outside the sandbox. Developer ID
        distribution; sandbox re-evaluated if this goes to the App Store.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
</dict>
</plist>
